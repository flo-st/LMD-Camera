<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>LmdCamera</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>$(LMD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">..\..\SteamLibrary\steamapps\common\Lonely Mountains - Downhill</GameDir>
    <MelonDir>$(GameDir)\MelonLoader</MelonDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="$(MelonDir)\net6\MelonLoader.dll" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Runtime.dll" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Assembly-CSharp.dll" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Il2Cppmscorlib.dll" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
