<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>LMD_Camera</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(LMD_GAME_DIR)' != ''">$(LMD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">..\..\SteamLibrary\steamapps\common\Lonely Mountains - Downhill</GameDir>
    <MelonDir Condition="'$(MelonDir)' == ''">$(GameDir)/MelonLoader</MelonDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(MelonDir)/Il2CppAssemblies/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(MelonDir)/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(MelonDir)/Il2CppAssemblies/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(MelonDir)/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(MelonDir)/Il2CppAssemblies/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MelonDir)/net6/MelonLoader.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonDir)/net6/Il2CppInterop.Runtime.dll</HintPath></Reference>
  </ItemGroup>
  
  <Target Name="DeployMod" AfterTargets="Build" Condition="Exists('$(GameDir)/Mods')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir)/Mods" />
  </Target>

</Project>
